# Auto detect text files and perform LF normalization
* text=auto

# HTML files
*.html text eol=lf
*.htm text eol=lf

# CSS files
*.css text eol=lf

# JavaScript files
*.js text eol=lf

# Markdown files
*.md text eol=lf

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# License and README
LICENSE text eol=lf
README* text eol=lf

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Web fonts (binary)
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
